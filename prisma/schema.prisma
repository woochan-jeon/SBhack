// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // JSON-encoded string[] of freeform team-member names — the workspace has
  // no accounts, so assignees are just names, not linked records.
  assigneeNames String @default("[]")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Slack channel this task should post updates to, picked per-task.
  slackChannelId   String?
  slackChannelName String?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#611f69")
  createdAt DateTime @default(now())

  tasks Task[]
}

// Singleton row: the team's shared Google Calendar connection.
model CalendarConnection {
  id           String   @id @default(cuid())
  googleEmail  String
  // JSON-encoded string[] of calendar IDs shown together in # 캘린더.
  calendarIds  String   @default("[\"primary\"]")
  // Drive folder the # 드라이브 channel is scoped to. Null means "My Drive" root.
  driveRootFolderId   String?
  driveRootFolderName String?
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  updatedAt    DateTime @updatedAt
}

// Singleton row: the team's Slack workspace connection (bot token from OAuth).
model SlackConnection {
  id          String   @id @default(cuid())
  teamName    String
  teamId      String
  botUserId   String
  accessToken String
  createdAt   DateTime @default(now())
}

// Singleton row: the team-shared flowboard canvas. Stored as one JSON blob
// (projects/tasks/markers/pan/zoom) since the whole board is saved wholesale
// from the client canvas rather than queried field-by-field.
model FlowBoard {
  id        String   @id @default(cuid())
  stateJson String
  updatedAt DateTime @updatedAt
}

enum WorkLogStatus {
  DONE
  PLANNED
}

// A selectable identity for # 업무일지 entries. There's no login/account system
// in this app, so this is just a display-name registry (picked client-side
// and remembered per browser), not a real user record.
model WorkLogMember {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  entries WorkLogEntry[]
}

// One day's freeform note from one member in # 업무일지, mirroring the team's
// old per-person calendar spreadsheet (검정 = done, 파랑 = planned).
model WorkLogEntry {
  id        String        @id @default(cuid())
  date      DateTime
  content   String
  status    WorkLogStatus @default(PLANNED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberId String
  member   WorkLogMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([memberId, date])
}

// Shared team credentials for # 비밀번호. Gated behind a passphrase at the page
// level (see src/lib/password-gate.ts) since the workspace itself has no login.
model PasswordEntry {
  id        String   @id @default(cuid())
  service   String
  account   String?
  password  String
  note      String?
  sourceUrl String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Curated agenda/decision summaries for the # 회의 아카이브 channel, sourced from
// the Gemini-generated meeting minutes in the Drive "Meet Recordings" folder.
model MeetingSummary {
  id          String   @id @default(cuid())
  driveFileId String   @unique
  meetingDate DateTime
  title       String
  // JSON-encoded { agenda: string, decision: string | null }[] — each agenda
  // item is paired inline with its decision (or null if still undecided).
  itemsJson   String
  sourceUrl   String?
  createdAt   DateTime @default(now())
}
