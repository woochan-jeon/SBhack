# CloudFX 환경변수 — 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
# 하나도 안 채워도 예시 데이터로 앱은 실행됩니다.

# --- Claude (AI 챗) ---
# 없으면 규칙 기반 폴백 응답이 나갑니다.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- AWS (실제 비용 데이터/조치) ---
# 아래 3개를 채우면 자동으로 실데이터 모드로 전환됩니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# 강제로 AWS 모드를 켜고 싶을 때(예: ~/.aws/credentials 사용): true
# USE_AWS=

# 서버 포트
PORT=3000
